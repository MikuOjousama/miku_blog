{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mikufans-cms",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mikufans-content",
      "database_id": "3522f4c0-e1a9-4e40-b0ca-bc5c0b43870d"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": true
    }
  ]
}
